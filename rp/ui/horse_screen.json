{
  "namespace": "horse",
  "test_button_bg@common.dialog_background_opaque": {},
  "test_button_default": {
    "type": "panel",
    "size": ["100%", "100%"],
    "controls": [
      { "bg@horse.test_button_bg": {} },
      { "lbl": { "type": "label", "text": "TEST", "size": ["100%", "100%"], "text_alignment": "center", "color": [1, 1, 1] } }
    ]
  },
  "my_custom_horse_action_button@common.button": {
    "size": [80, 30],
    "offset": [0, 0],
    "anchor_from": "center",
    "anchor_to": "center",
    "layer": 10,
    "default_control": "horse.test_button_default",
    "hover_control": "horse.test_button_default",
    "pressed_control": "horse.test_button_default",
    "button_mappings": [
      { "from_button_id": "button.menu_select", "to_button_id": "button.my_custom_script_event", "mapping_type": "pressed" }
    ]
  },
  "oc_panel": {
    "type": "panel",
    "controls": [
      { "container_gamepad_helpers@common.container_gamepad_helpers": {} },
      {
        "root_panel@common.root_panel": {
          "size": [200, 150],
          "layer": 1,
          "controls": [
            { "common_panel@common.common_panel": { "size": [200, 150] } },
            { "my_custom_horse_action_button@horse.my_custom_horse_action_button": {} }
          ]
        }
      }
    ]
  },
  "horse_screen@common.inventory_screen_common": {
    "$close_on_player_hurt|default": false,
    "close_on_player_hurt": "$close_on_player_hurt",
    "variables": [
      { "requires": "true", "$screen_content": "horse.oc_panel" }
    ]
  }
}
