{
  "namespace": "horse",
  "npc_test_button@common_buttons.light_glyph_button": {
    "size": [80, 30],
    "offset": [0, 0],
    "anchor_from": "center",
    "anchor_to": "center",
    "layer": 10,
    "$button_content": "npc_interact.plus_icon",
    "$pressed_button_name": "button.expand_action_edit",
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "actions_collection",
        "binding_collection_prefix": "actions"
      }
    ]
  },
  "oc_panel": {
    "type": "panel",
    "controls": [
      { "container_gamepad_helpers@common.container_gamepad_helpers": {} },
      {
        "root_panel@common.root_panel": {
          "size": [200, 150],
          "layer": 1,
          "controls": [
            { "common_panel@common.common_panel": { "size": [200, 150] } },
            { "npc_test_button@horse.npc_test_button": {} }
          ]
        }
      }
    ]
  },
  "horse_screen@common.inventory_screen_common": {
    "$close_on_player_hurt|default": false,
    "close_on_player_hurt": "$close_on_player_hurt",
    "variables": [
      { "requires": "true", "$screen_content": "horse.oc_panel" }
    ]
  }
}
